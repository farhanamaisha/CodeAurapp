
package parser;

import java_cup.runtime.*;
import ast.ASTNode;

parser code {:
    private ASTNode node(String type, String value, int line) {
        return new ASTNode(type, value, line);
    }

    private int lineOf(int position) {
        // JavaLexer stores source lines as 1-based positions in Symbol.left.
        return position > 0 ? position : 1;
    }

    private String javaType(String type) {
        if (type.equals("boolean")) return "bool";
        if (type.equals("double")) return "float";
        return type;
    }

    @Override
    public void syntax_error(Symbol token) {
        String unexpected = token.value == null
            ? "end of input"
            : "'" + token.value + "'";

        System.err.println(
            "Syntax Error at line " + lineOf(token.left) +
            ": unexpected token " + unexpected
        );
    }

    @Override
    public void unrecovered_syntax_error(Symbol token) throws java.lang.Exception {
        syntax_error(token);
        throw new Exception(
            "Syntax Error at line " + lineOf(token.left) +
            ": unable to recover from this syntax error."
        );
    }
:};

/* Special precedence terminals */
terminal IFX, UMINUS;

/* Java class and method keywords */
terminal CLASS, PUBLIC, PRIVATE, PROTECTED, STATIC, VOID, MAIN, IMPORT;

/* Data types */
terminal INT, FLOAT, DOUBLE, BOOLEAN, STRING;

/* Scanner keywords */
terminal SCANNER, NEW, IN;
terminal NEXT_INT, NEXT_FLOAT, NEXT_DOUBLE, NEXT_LINE;

/* Control flow */
terminal IF, ELSE, WHILE, FOR, SWITCH, CASE, DEFAULT, BREAK;

/* Output */
terminal SYSTEM, OUT, PRINTLN, PRINT;

/* Operators */
terminal AND, OR, EQUAL, NOT_EQUAL;
terminal LESS_EQUAL, GREATER_EQUAL, INCREMENT, DECREMENT;
terminal PLUS, MINUS, MULTIPLY, DIVIDE, MODULO;
terminal ASSIGN, LESS, GREATER, NOT;

/* Symbols */
terminal LBRACE, RBRACE, LPAREN, RPAREN;
terminal LBRACKET, RBRACKET, SEMICOLON, COMMA, DOT, COLON;

/* Values */
terminal String IDENTIFIER;
terminal String INTEGER_LITERAL, FLOAT_LITERAL;
terminal String STRING_LITERAL, BOOLEAN_LITERAL;

/* Non-terminals */
non terminal ASTNode program, class_decl, main_method;
non terminal ASTNode import_declaration;
non terminal ASTNode block, statement_list, statement;
non terminal ASTNode declaration, declaration_no_semi;
non terminal ASTNode array_declaration;
non terminal ASTNode assignment, assignment_no_semi;
non terminal ASTNode array_assignment;
non terminal ASTNode scanner_declaration;
non terminal ASTNode method_call;
non terminal ASTNode switch_statement, switch_cases, switch_case, switch_default;
non terminal ASTNode print_statement;
non terminal ASTNode if_statement, while_statement, for_statement;
non terminal ASTNode for_init, for_update;
non terminal ASTNode expression, logical_or, logical_and;
non terminal ASTNode equality, comparison, term, factor, unary, primary;
non terminal ASTNode increment_statement;

non terminal String type_name;
non terminal String qualified_name;
non terminal String cast_type;

/* Operator precedence */
precedence nonassoc IFX;
precedence right ELSE;
precedence left OR;
precedence left AND;
precedence left EQUAL, NOT_EQUAL;
precedence left LESS, GREATER, LESS_EQUAL, GREATER_EQUAL;
precedence left PLUS, MINUS;
precedence left MULTIPLY, DIVIDE, MODULO;
precedence right NOT, UMINUS;

start with program;

/* =========================================================
   PROGRAM AND CLASS
   ========================================================= */

program ::=
    import_declaration:i class_decl:c
    {:
        ASTNode root = new ASTNode("PROGRAM", null, lineOf(cleft));
        root.addChild(c);
        RESULT = root;
    :}
    ;

import_declaration ::=
    IMPORT qualified_name SEMICOLON
    {: RESULT = new ASTNode("IMPORT", null, 1); :}
    |
    {:
        RESULT = new ASTNode("IMPORTS", null, 1);
    :}
    ;

qualified_name ::=
    IDENTIFIER:name
    {: RESULT = name; :}
    |
    SCANNER
    {: RESULT = "Scanner"; :}
    |
    qualified_name:q DOT IDENTIFIER:name
    {: RESULT = q + "." + name; :}
    |
    qualified_name:q DOT SCANNER
    {: RESULT = q + ".Scanner"; :}
    ;

class_decl ::=
    PUBLIC:pub CLASS IDENTIFIER:name LBRACE main_method:m RBRACE
    {: RESULT = m; :}
    |
    CLASS:classToken IDENTIFIER:name LBRACE main_method:m RBRACE
    {: RESULT = m; :}
    ;

main_method ::=
    PUBLIC:pub STATIC VOID MAIN
    LPAREN STRING LBRACKET RBRACKET IDENTIFIER RPAREN
    block:b
    {: RESULT = b; :}
    ;

/* =========================================================
   BLOCKS AND STATEMENTS
   ========================================================= */

block ::=
    LBRACE:open statement_list:s RBRACE
    {:
        ASTNode result = new ASTNode("BLOCK", null, lineOf(openleft));

        for (ASTNode child : s.getChildren()) {
            result.addChild(child);
        }

        RESULT = result;
    :}
    ;

statement_list ::=
    statement_list:l statement:s
    {:
        l.addChild(s);
        RESULT = l;
    :}
    |
    {:
        RESULT = new ASTNode("BLOCK", null, 1);
    :}
    ;

statement ::=
    declaration:d
    {: RESULT = d; :}
    |
    array_declaration:d
    {: RESULT = d; :}
    |
    assignment:a
    {: RESULT = a; :}
    |
    array_assignment:a
    {: RESULT = a; :}
    |
    increment_statement:i SEMICOLON
    {: RESULT = i; :}
    |
    scanner_declaration:s
    {: RESULT = s; :}
    |
    method_call:m
    {: RESULT = m; :}
    |
    print_statement:p
    {: RESULT = p; :}
    |
    if_statement:i
    {: RESULT = i; :}
    |
    while_statement:w
    {: RESULT = w; :}
    |
    for_statement:f
    {: RESULT = f; :}
    |
    switch_statement:s
    {: RESULT = s; :}
    |
    BREAK:breakToken SEMICOLON
    {: RESULT = new ASTNode("BREAK", null, lineOf(breakTokenleft)); :}
    |
    block:b
    {: RESULT = b; :}
    ;

/* =========================================================
   DATA TYPES
   ========================================================= */

type_name ::=
    INT
    {: RESULT = "int"; :}
    |
    FLOAT
    {: RESULT = "float"; :}
    |
    DOUBLE
    {: RESULT = "double"; :}
    |
    BOOLEAN
    {: RESULT = "boolean"; :}
    |
    STRING
    {: RESULT = "String"; :}
    ;

/* =========================================================
   VARIABLE DECLARATIONS
   ========================================================= */

declaration ::=
    type_name:t IDENTIFIER:name SEMICOLON
    {:
        RESULT = new ASTNode("DECLARATION", javaType(t), lineOf(nameleft));
        RESULT.addChild(node("IDENTIFIER", name, lineOf(nameleft)));
    :}
    |
    type_name:t IDENTIFIER:name ASSIGN expression:e SEMICOLON
    {:
        RESULT = new ASTNode("DECLARATION", javaType(t), lineOf(nameleft));
        RESULT.addChild(node("IDENTIFIER", name, lineOf(nameleft)));
        RESULT.addChild(e);
    :}
    ;

declaration_no_semi ::=
    type_name:t IDENTIFIER:name
    {:
        RESULT = new ASTNode("DECLARATION", javaType(t), lineOf(nameleft));
        RESULT.addChild(node("IDENTIFIER", name, lineOf(nameleft)));
    :}
    |
    type_name:t IDENTIFIER:name ASSIGN expression:e
    {:
        RESULT = new ASTNode("DECLARATION", javaType(t), lineOf(nameleft));
        RESULT.addChild(node("IDENTIFIER", name, lineOf(nameleft)));
        RESULT.addChild(e);
    :}
    ;

array_declaration ::=
    INT LBRACKET RBRACKET IDENTIFIER:name ASSIGN NEW INT
    LBRACKET expression:size RBRACKET SEMICOLON
    {:
        RESULT = new ASTNode("ARRAY_DECL", "int", lineOf(nameleft));
        RESULT.addChild(node("IDENTIFIER", name, lineOf(nameleft)));
        RESULT.addChild(size);
    :}
    ;

/* =========================================================
   SCANNER INPUT
   Scanner sc = new Scanner(System.in);
   ========================================================= */

scanner_declaration ::=
    SCANNER IDENTIFIER:name ASSIGN NEW SCANNER
    LPAREN SYSTEM DOT IN RPAREN SEMICOLON
    {:
        RESULT = new ASTNode("SCANNER_DECL", name, lineOf(nameleft));
    :}
    ;

method_call ::=
    IDENTIFIER:name DOT IDENTIFIER:method LPAREN RPAREN SEMICOLON
    {:
        RESULT = new ASTNode("METHOD_CALL", method, lineOf(nameleft));
        RESULT.addChild(node("IDENTIFIER", name, lineOf(nameleft)));
    :}
    ;

array_assignment ::=
    IDENTIFIER:name LBRACKET expression:index RBRACKET
    ASSIGN expression:value SEMICOLON
    {:
        RESULT = new ASTNode("ARRAY_ASSIGN", name, lineOf(nameleft));
        RESULT.addChild(index);
        RESULT.addChild(value);
    :}
    ;

switch_statement ::=
    SWITCH:token LPAREN expression:value RPAREN
    LBRACE switch_cases:cases RBRACE
    {:
        RESULT = new ASTNode("SWITCH", null, lineOf(tokenleft));
        RESULT.addChild(value);
        for (ASTNode switchCase : cases.getChildren()) {
            RESULT.addChild(switchCase);
        }
    :}
    ;

switch_cases ::=
    switch_cases:cases switch_case:one
    {:
        cases.addChild(one);
        RESULT = cases;
    :}
    |
    switch_cases:cases switch_default:other
    {:
        cases.addChild(other);
        RESULT = cases;
    :}
    |
    {:
        RESULT = new ASTNode("SWITCH_CASES", null, 1);
    :}
    ;

switch_case ::=
    CASE expression:value COLON statement_list:body
    {:
        RESULT = new ASTNode("CASE", null, lineOf(valueleft));
        RESULT.addChild(value);
        RESULT.addChild(body);
    :}
    ;

switch_default ::=
    DEFAULT COLON statement_list:body
    {:
        RESULT = new ASTNode("DEFAULT", null, lineOf(bodyleft));
        RESULT.addChild(body);
    :}
    ;

/* =========================================================
   ASSIGNMENTS
   ========================================================= */

assignment ::=
    IDENTIFIER:name ASSIGN expression:e SEMICOLON
    {:
        RESULT = new ASTNode("ASSIGNMENT", name, lineOf(nameleft));
        RESULT.addChild(e);
    :}
    ;

assignment_no_semi ::=
    IDENTIFIER:name ASSIGN expression:e
    {:
        RESULT = new ASTNode("ASSIGNMENT", name, lineOf(nameleft));
        RESULT.addChild(e);
    :}
    ;

/* =========================================================
   INCREMENT AND DECREMENT
   ========================================================= */

increment_statement ::=
    IDENTIFIER:name INCREMENT
    {:
        int line = lineOf(nameleft);
        RESULT = new ASTNode("ASSIGNMENT", name, line);

        ASTNode binary = new ASTNode("BINARY", "+", line);
        binary.addChild(node("IDENTIFIER", name, line));
        binary.addChild(node("LITERAL", "1", line));

        RESULT.addChild(binary);
    :}
    |
    IDENTIFIER:name DECREMENT
    {:
        int line = lineOf(nameleft);
        RESULT = new ASTNode("ASSIGNMENT", name, line);

        ASTNode binary = new ASTNode("BINARY", "-", line);
        binary.addChild(node("IDENTIFIER", name, line));
        binary.addChild(node("LITERAL", "1", line));

        RESULT.addChild(binary);
    :}
    ;

/* =========================================================
   PRINT STATEMENTS
   ========================================================= */

print_statement ::=
    SYSTEM:sys DOT OUT DOT PRINTLN
    LPAREN expression:e RPAREN SEMICOLON
    {:
        RESULT = new ASTNode("PRINT", null, lineOf(sysleft));
        RESULT.addChild(e);
    :}
    |
    PRINT:printToken LPAREN expression:e RPAREN SEMICOLON
    {:
        RESULT = new ASTNode("PRINT", null, lineOf(printTokenleft));
        RESULT.addChild(e);
    :}
    ;

/* =========================================================
   IF AND ELSE
   ========================================================= */

if_statement ::=
    IF:ifToken LPAREN expression:e RPAREN statement:s
    {:
        RESULT = new ASTNode("IF", null, lineOf(ifTokenleft));
        RESULT.addChild(e);
        RESULT.addChild(s);
    :}
    %prec IFX
    |
    IF:ifToken LPAREN expression:e RPAREN statement:s
    ELSE statement:other
    {:
        RESULT = new ASTNode("IF", null, lineOf(ifTokenleft));
        RESULT.addChild(e);
        RESULT.addChild(s);
        RESULT.addChild(other);
    :}
    ;

/* =========================================================
   WHILE LOOP
   ========================================================= */

while_statement ::=
    WHILE:whileToken LPAREN expression:e RPAREN statement:s
    {:
        RESULT = new ASTNode("WHILE", null, lineOf(whileTokenleft));
        RESULT.addChild(e);
        RESULT.addChild(s);
    :}
    ;

/* =========================================================
   FOR LOOP
   ========================================================= */

for_statement ::=
    FOR:forToken LPAREN for_init:i SEMICOLON
    expression:e SEMICOLON
    for_update:u RPAREN statement:s
    {:
        RESULT = new ASTNode("FOR", null, lineOf(forTokenleft));
        RESULT.addChild(i);
        RESULT.addChild(e);
        RESULT.addChild(u);
        RESULT.addChild(s);
    :}
    |
    FOR:forToken LPAREN for_init:i SEMICOLON
    SEMICOLON for_update:u RPAREN statement:s
    {:
        ASTNode result = new ASTNode("FOR", null, lineOf(forTokenleft));
        result.addChild(i);
        result.addChild(node("EMPTY", null, lineOf(forTokenleft)));
        result.addChild(u);
        result.addChild(s);
        RESULT = result;
    :}
    ;

for_init ::=
    declaration_no_semi:d
    {: RESULT = d; :}
    |
    assignment_no_semi:a
    {: RESULT = a; :}
    |
    {: RESULT = node("EMPTY", null, 1); :}
    ;

for_update ::=
    assignment_no_semi:a
    {: RESULT = a; :}
    |
    increment_statement:i
    {: RESULT = i; :}
    |
    {: RESULT = node("EMPTY", null, 1); :}
    ;

/* =========================================================
   EXPRESSIONS
   ========================================================= */

expression ::=
    logical_or:e
    {: RESULT = e; :}
    ;

/* Logical OR */
logical_or ::=
    logical_or:l OR:op logical_and:r
    {:
        RESULT = new ASTNode("BINARY", "||", lineOf(opleft));
        RESULT.addChild(l);
        RESULT.addChild(r);
    :}
    |
    logical_and:e
    {: RESULT = e; :}
    ;

/* Logical AND */
logical_and ::=
    logical_and:l AND:op equality:r
    {:
        RESULT = new ASTNode("BINARY", "&&", lineOf(opleft));
        RESULT.addChild(l);
        RESULT.addChild(r);
    :}
    |
    equality:e
    {: RESULT = e; :}
    ;

/* Equality */
equality ::=
    equality:l EQUAL:op comparison:r
    {:
        RESULT = new ASTNode("BINARY", "==", lineOf(opleft));
        RESULT.addChild(l);
        RESULT.addChild(r);
    :}
    |
    equality:l NOT_EQUAL:op comparison:r
    {:
        RESULT = new ASTNode("BINARY", "!=", lineOf(opleft));
        RESULT.addChild(l);
        RESULT.addChild(r);
    :}
    |
    comparison:e
    {: RESULT = e; :}
    ;

/* Comparison */
comparison ::=
    comparison:l LESS:op term:r
    {:
        RESULT = new ASTNode("BINARY", "<", lineOf(opleft));
        RESULT.addChild(l);
        RESULT.addChild(r);
    :}
    |
    comparison:l GREATER:op term:r
    {:
        RESULT = new ASTNode("BINARY", ">", lineOf(opleft));
        RESULT.addChild(l);
        RESULT.addChild(r);
    :}
    |
    comparison:l LESS_EQUAL:op term:r
    {:
        RESULT = new ASTNode("BINARY", "<=", lineOf(opleft));
        RESULT.addChild(l);
        RESULT.addChild(r);
    :}
    |
    comparison:l GREATER_EQUAL:op term:r
    {:
        RESULT = new ASTNode("BINARY", ">=", lineOf(opleft));
        RESULT.addChild(l);
        RESULT.addChild(r);
    :}
    |
    term:e
    {: RESULT = e; :}
    ;

/* Addition and subtraction */
term ::=
    term:l PLUS:op factor:r
    {:
        RESULT = new ASTNode("BINARY", "+", lineOf(opleft));
        RESULT.addChild(l);
        RESULT.addChild(r);
    :}
    |
    term:l MINUS:op factor:r
    {:
        RESULT = new ASTNode("BINARY", "-", lineOf(opleft));
        RESULT.addChild(l);
        RESULT.addChild(r);
    :}
    |
    factor:e
    {: RESULT = e; :}
    ;

/* Multiplication, division and modulo */
factor ::=
    factor:l MULTIPLY:op unary:r
    {:
        RESULT = new ASTNode("BINARY", "*", lineOf(opleft));
        RESULT.addChild(l);
        RESULT.addChild(r);
    :}
    |
    factor:l DIVIDE:op unary:r
    {:
        RESULT = new ASTNode("BINARY", "/", lineOf(opleft));
        RESULT.addChild(l);
        RESULT.addChild(r);
    :}
    |
    factor:l MODULO:op unary:r
    {:
        RESULT = new ASTNode("BINARY", "%", lineOf(opleft));
        RESULT.addChild(l);
        RESULT.addChild(r);
    :}
    |
    unary:e
    {: RESULT = e; :}
    ;

/* =========================================================
   UNARY EXPRESSIONS
   ========================================================= */

unary ::=
    NOT:op unary:e
    {:
        RESULT = new ASTNode("UNARY", "!", lineOf(opleft));
        RESULT.addChild(e);
    :}
    %prec NOT
    |
    MINUS:op unary:e
    {:
        RESULT = new ASTNode("UNARY", "-", lineOf(opleft));
        RESULT.addChild(e);
    :}
    %prec UMINUS
    |
    primary:e
    {: RESULT = e; :}
    ;

/* =========================================================
   PRIMARY EXPRESSIONS
   Scanner methods:
   sc.nextInt()
   sc.nextFloat()
   sc.nextLine()
   ========================================================= */

primary ::=
    LPAREN cast_type:type RPAREN unary:value
    {:
        RESULT = new ASTNode("CAST", type, lineOf(typeleft));
        RESULT.addChild(value);
    :}
    |
    IDENTIFIER:name LBRACKET expression:index RBRACKET
    {:
        RESULT = new ASTNode("ARRAY_ACCESS", name, lineOf(nameleft));
        RESULT.addChild(index);
    :}
    |
    IDENTIFIER:name
    {:
        RESULT = node("IDENTIFIER", name, lineOf(nameleft));
    :}
    |
    INTEGER_LITERAL:value
    {:
        RESULT = node("LITERAL", value, lineOf(valueleft));
    :}
    |
    FLOAT_LITERAL:value
    {:
        RESULT = node("LITERAL", value, lineOf(valueleft));
    :}
    |
    BOOLEAN_LITERAL:value
    {:
        RESULT = node("LITERAL", value, lineOf(valueleft));
    :}
    |
    STRING_LITERAL:value
    {:
        RESULT = node("LITERAL", value, lineOf(valueleft));
    :}
    |
    IDENTIFIER:name DOT NEXT_INT:method LPAREN RPAREN
    {:
        RESULT = new ASTNode("INPUT", "int", lineOf(nameleft));
    :}
    |
    IDENTIFIER:name DOT NEXT_FLOAT:method LPAREN RPAREN
    {:
        RESULT = new ASTNode("INPUT", "float", lineOf(nameleft));
    :}
    |
    IDENTIFIER:name DOT NEXT_DOUBLE:method LPAREN RPAREN
    {:
        RESULT = new ASTNode("INPUT", "double", lineOf(nameleft));
    :}
    |
    IDENTIFIER:name DOT NEXT_LINE:method LPAREN RPAREN
    {:
        RESULT = new ASTNode("INPUT", "String", lineOf(nameleft));
    :}
    |
    LPAREN expression:e RPAREN
    {: RESULT = e; :}
    ;

cast_type ::=
    INT {: RESULT = "int"; :}
    |
    FLOAT {: RESULT = "float"; :}
    |
    DOUBLE {: RESULT = "float"; :}
    ;
